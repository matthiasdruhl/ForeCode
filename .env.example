# Server only. Never prefix credentials with NEXT_PUBLIC_.
META_MODEL_API_KEY=
META_API_BASE_URL=
META_MODEL=
# Configuration alone does not establish live model access.
# Set only after confirming account, model, provider hard limits and credits.
META_CALLS_ENABLED=false
# Separate operator approval after account/model access, credits and spending
# controls are confirmed. Existing credentials/enable flags are not approval.
META_SPENDING_APPROVED=false
# Exact public deployment origin; never inferred from forwarded headers.
FORECODE_ORIGIN=http://127.0.0.1:3000
# This slice allowlists only https://api.meta.ai/v1 and these explicit models:
# muse-spark-1.3 or muse-spark-1.3-contributor. No automatic provider/model switch.
# Contributor content may be used by Meta for training; review before consenting.
# Optional exact-payload smoke gate: SHA-256 of canonical provider request body.
# When set, other payloads fail closed. Use call limit 1 for the first smoke.
# META_APPROVED_PAYLOAD_SHA256=
# META_APPROVED_CALL_LIMIT=1
