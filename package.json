{
  "name": "forecode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "fixtures/booking-v1"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && npm run build --workspace @forecode/booking-v1",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit && npm run typecheck --workspace @forecode/booking-v1",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:fixture-e2e": "playwright test --config playwright.fixture.config.ts",
    "test:plan": "vitest run --config vitest.plan.config.ts",
    "snapshot:booking": "node --import tsx scripts/evaluator/booking-v1/freeze.ts",
    "prepare:booking": "node --import tsx scripts/experiments/prepare-booking.ts",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "experiment:booking": "node --import tsx scripts/experiments/runner/cli.ts",
    "acceptance:booking": "node --conditions=react-server --import tsx scripts/experiments/runner/offline-cli.ts",
    "bundle:booking": "node --import tsx scripts/experiments/isolation/bundle.ts"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "vitest": "5.0.5"
  }
}
